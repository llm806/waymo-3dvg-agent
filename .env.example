# 仅在没有 .env 时复制；已有配置不要覆盖，密钥不要提交或输出。
DASHSCOPE_API_KEY=
# 接入地址须与密钥所属区域／服务／套餐匹配；示例地址不是所有 Key 通用。
# 若使用专属套餐入口，请填写该套餐实际提供的 compatible-mode/v1 地址。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 代码默认模型；本地可覆盖为该端点实际支持图像输入的模型，修改后重启后端。
DASHSCOPE_MODEL=qwen3.8-flash
# 模型请求并发上限（1～4），遇到接口限流时可调低。
ANNOTATION_MODEL_CONCURRENCY=4
